# Copy to .env and fill in. README.md explains where each value comes from.
PORT=8787
DATABASE_URL=postgres://user:password@host:5432/quotepilot
# The public https address of this server once deployed.
PUBLIC_URL=http://localhost:8787
# Optional: address of the web app, linked from the post-checkout page.
APP_URL=
# Set to 1 behind a hosting provider's proxy (Render, Fly, Railway...) so rate limiting sees real IPs.
TRUST_PROXY=

# Stripe (leave blank to run without billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 to have the server create the Pro product and prices in Stripe when it starts, if missing.
STRIPE_AUTO_SETUP=

# Password-reset emails via Resend (leave blank to print them to the server log)
RESEND_API_KEY=
MAIL_FROM=QuotePilot <no-reply@yourdomain.com>
